        "@com_google_googletest//:gtest_main",
    ],
)

# --- end-to-end tests (real CycloneDDS, bind real sockets) --------------------
# Tagged "manual": excluded from `bazel test //...`; run explicitly when the
# environment allows real network traffic.

rcllite_cc_test(
    name = "comms_test",
    # Discovery + service roundtrips need room on loaded machines.
    size = "large",
    srcs = ["comms_test.cpp"],
    tags = ["manual"],
    deps = [
        "//msg:rcl_interfaces",
        "//msg:rosgraph_msgs",
        "//src/rcllite",
        "@com_google_googletest//:gtest_main",
    ],
)

rcllite_cc_test(
    name = "qos_e2e_test",
